# ==============================================================================
# EasyInvite Environment Configuration Template
# Safe to commit to GitHub. Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# Server Port
PORT=3000

# Outgoing Google SMTP Credentials
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=yourname@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Your Name

# Google Play Closed Testing Configuration (Defaults)
APP_NAME=Your App Name
APP_PACKAGE_ID=com.company.app
CLOSED_TESTING_URL=https://play.google.com/apps/testing/com.company.app
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.company.app
